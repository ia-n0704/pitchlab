# Copy to .env and adjust as needed. docker-compose reads .env at the repo root.

# Anthropic (optional — without this the LLM falls back to a templated comment)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# JWT signing secret (must be set to something stable in real deployments)
JWT_SECRET=change-me-in-production

# Cloudflare R2 (only if you set STORAGE_BACKEND=r2 in docker-compose)
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pitchlab-videos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
