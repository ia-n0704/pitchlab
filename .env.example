# Copy to .env and adjust as needed. docker-compose reads .env at the repo root.

# Anthropic (optional — without this the LLM falls back to a templated comment)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# JWT signing secret (must be set to something stable in real deployments)
JWT_SECRET=change-me-in-production

# Email verification
# EXPOSE_VERIFICATION_CODE=true returns the 6-digit code in the signup/resend
# response so the flow works without an SMTP server. Set false in production.
EXPOSE_VERIFICATION_CODE=true
# Configure SMTP to actually send verification emails (optional):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@pitchlab.local

# Pose estimation backend
# "hq" = ViTPose 2D + MediaPipe 3D fusion + temporal smoothing (default, best accuracy;
#         first run downloads ~1.4GB of model weights). "mediapipe" = BlazePose only.
# POSE_BACKEND=hq
# VITPOSE_MODEL=usyd-community/vitpose-plus-large   # vitpose-plus-huge for max accuracy on GPU
# VITPOSE_DETECT_EVERY=4
# POSE_DEVICE=            # cuda | mps | cpu (empty = auto)

# Cloudflare R2 (only if you set STORAGE_BACKEND=r2 in docker-compose)
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pitchlab-videos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
